# Copy this file to .env and fill in what you need.
# .env is git-ignored. Every value here is optional; scripts/charter-ipfs.sh
# falls back to sane defaults for anything left unset. A real exported
# environment variable always overrides the value in .env.

# Required by `pin`. Create a Pinata API key with Files:Write scope at
# https://app.pinata.cloud/developers/api-keys and paste the JWT it gives you.
PINATA_JWT=

# Ethereum JSON-RPC endpoint used by `diff` to read the ENS record.
# Default: https://ethereum-rpc.publicnode.com
RPC_URL=

# IPFS gateway used by `diff` to fetch the onchain content, and printed
# by `pin` next to the resulting CID.
# Default: https://gateway.pinata.cloud/ipfs
IPFS_GATEWAY_URL=
